<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>DDL-01 | Distribuidor de Líquido</title>
<style>
:root {
  --navy:#0c3f6e;
  --blue:#0b63b6;
  --blue2:#174f83;
  --green:#14804a;
  --red:#c62f2f;
  --amber:#b7791f;
  --bg:#edf3f8;
  --panel:#ffffff;
  --ink:#122033;
  --muted:#64748b;
  --line:#d9e3ee;
  --soft:#f6f9fc;
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:Inter,Segoe UI,Arial,sans-serif;background:var(--bg);color:var(--ink)}
button{font:inherit}
.app{min-height:100vh;display:flex;flex-direction:column}
.topbar{
  background:linear-gradient(100deg,#0a365f,#0d5a95);
  color:#fff;padding:14px 20px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;
  box-shadow:0 5px 20px rgba(12,63,110,.18)
}
.brand{display:flex;gap:12px;align-items:center}
.brand-icon{width:44px;height:44px;border:1px solid rgba(255,255,255,.35);border-radius:12px;display:grid;place-items:center;font-size:23px;background:rgba(255,255,255,.08)}
.brand h1{margin:0;font-size:clamp(20px,2.6vw,32px);letter-spacing:.2px}
.brand p{margin:3px 0 0;font-size:13px;opacity:.88}
.tag-card{display:flex;gap:18px;align-items:center;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.3);border-radius:12px;padding:9px 13px;font-size:13px}
.tag-card b{font-size:15px}
.main{width:min(1420px,100%);margin:0 auto;padding:16px;display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:16px;align-items:start}
.viewer-card,.side-card{background:var(--panel);border:1px solid var(--line);border-radius:16px;box-shadow:0 10px 28px rgba(15,23,42,.07)}
.viewer-head{padding:12px 14px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.viewer-head strong{font-size:15px}
.viewer-head span{font-size:12px;color:var(--muted)}
.canvas{position:relative;background:#fff;border-radius:0 0 16px 16px;overflow:hidden}
.canvas img{display:block;width:100%;height:auto;user-select:none;-webkit-user-drag:none}
.zone{
  position:absolute;border:2px solid transparent;background:transparent;border-radius:14px;cursor:pointer;
  transition:.18s ease;outline:none
}
.zone:hover,.zone:focus-visible{border-color:rgba(11,99,182,.7);background:rgba(11,99,182,.08);box-shadow:0 0 0 4px rgba(11,99,182,.12)}
.zone::after{
  content:"";position:absolute;left:50%;top:50%;width:10px;height:10px;transform:translate(-50%,-50%);
  border-radius:50%;background:rgba(11,99,182,.85);box-shadow:0 0 0 6px rgba(11,99,182,.13);opacity:0;transition:.18s ease
}
.zone:hover::after,.zone:focus-visible::after{opacity:1}
.side-card{overflow:hidden}
.side-title{padding:14px 16px;background:var(--soft);border-bottom:1px solid var(--line)}
.side-title h2{margin:0;font-size:17px}
.side-title p{margin:4px 0 0;font-size:12px;color:var(--muted)}
.quick{padding:14px;display:grid;grid-template-columns:1fr 1fr;gap:10px}
.metric{border:1px solid var(--line);border-radius:12px;padding:10px;background:#fff}
.metric small{display:block;color:var(--muted);font-size:11px;margin-bottom:4px}
.metric b{font-size:15px}
.legend{border-top:1px solid var(--line);padding:12px 14px;display:grid;gap:9px}
.legend-item{display:flex;align-items:center;gap:9px;font-size:12px;color:#334155}
.dot{width:10px;height:10px;border-radius:50%;flex:0 0 10px}
.tip{margin:0 14px 14px;background:#eef6ff;border:1px solid #cfe4fa;border-radius:12px;padding:10px 11px;font-size:12px;color:#274c6e}
.drawer-backdrop{position:fixed;inset:0;background:rgba(2,13,26,.45);display:none;z-index:40}
.drawer-backdrop.show{display:block}
.drawer{
  position:fixed;top:0;right:0;height:100%;width:min(460px,92vw);background:#fff;z-index:50;
  transform:translateX(103%);transition:transform .28s ease;box-shadow:-18px 0 46px rgba(2,13,26,.22);
  display:flex;flex-direction:column
}
.drawer.show{transform:translateX(0)}
.drawer-head{padding:16px 18px;background:linear-gradient(100deg,#0a365f,#0d5a95);color:#fff;display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
.drawer-head h3{margin:0;font-size:21px}
.drawer-head p{margin:4px 0 0;font-size:12px;opacity:.86}
.close{border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.1);color:#fff;width:38px;height:38px;border-radius:10px;cursor:pointer;font-size:24px;line-height:1}
.drawer-body{padding:16px 18px 26px;overflow:auto}
.section{margin-bottom:18px}
.section h4{margin:0 0 9px;font-size:13px;text-transform:uppercase;letter-spacing:.06em;color:#466078}
.table{border:1px solid var(--line);border-radius:12px;overflow:hidden}
.row{display:grid;grid-template-columns:44% 56%;border-bottom:1px solid var(--line)}
.row:last-child{border-bottom:0}
.cell{padding:9px 10px;font-size:13px}
.cell.k{background:#f8fafc;font-weight:650;color:#334155}
.note{border-left:4px solid var(--blue);background:#f3f8fd;border-radius:8px;padding:10px 11px;font-size:12px;color:#456176}
.badge{display:inline-flex;align-items:center;gap:6px;padding:5px 8px;border-radius:999px;background:#ecf7f0;color:#17663d;font-size:12px;font-weight:650}
.list{margin:0;padding-left:18px;font-size:13px;color:#334155}
.list li{margin:6px 0}
.footer{padding:10px 16px;text-align:center;color:#708095;font-size:11px}
@media (max-width:1000px){
  .main{grid-template-columns:1fr}
  .side-card{order:-1}
  .quick{grid-template-columns:repeat(4,1fr)}
}
@media (max-width:680px){
  .main{padding:10px}
  .quick{grid-template-columns:1fr 1fr}
  .tag-card{width:100%;justify-content:space-between}
  .viewer-head span{width:100%}
  .row{grid-template-columns:1fr}
  .cell.k{border-bottom:1px dashed var(--line)}
}
</style>
</head>
<body>
<div class="app">
  <header class="topbar">
    <div class="brand">
      <div class="brand-icon">◉</div>
      <div>
        <h1>Distribuidor de Líquido</h1>
        <p>Ficha técnica interativa do vaso de pressão</p>
      </div>
    </div>
    <div class="tag-card">
      <div><span>TAG</span><br><b>DDL-01</b></div>
      <div><span>LD Nº</span><br><b>10</b></div>
      <div><span>Categoria</span><br><b>III</b></div>
    </div>
  </header>

  <main class="main">
    <section class="viewer-card">
      <div class="viewer-head">
        <strong>Vista do equipamento</strong>
        <span>Clique diretamente sobre o componente ou sobre o corpo do vaso.</span>
      </div>
      <div class="canvas" id="canvas">
        <img src="data:image/png;base64," alt="Distribuidor de líquido MADEF com válvulas, manômetro e válvula de segurança">

        <!-- Zonas clicáveis alinhadas à nova imagem -->
        <button class="zone" aria-label="Válvula de serviço de entrada" data-key="servico1"
          style="left:4.5%;top:29%;width:25%;height:17%"></button>

        <button class="zone" aria-label="Válvula de serviço superior" data-key="servico2"
          style="left:45%;top:11%;width:16%;height:22%"></button>

        <button class="zone" aria-label="Manômetro" data-key="manometro"
          style="left:65%;top:15%;width:13%;height:20%"></button>

        <button class="zone" aria-label="Válvula de segurança PSV" data-key="psv"
          style="left:80%;top:16%;width:17%;height:23%"></button>

        <button class="zone" aria-label="Válvula de serviço de saída inferior" data-key="servico3"
          style="left:6%;top:72%;width:27%;height:21%"></button>

        <button class="zone" aria-label="Válvula de serviço de dreno" data-key="servico4"
          style="left:56%;top:68%;width:25%;height:24%"></button>

        <button class="zone" aria-label="Corpo do vaso - dados gerais" data-key="equipamento"
          style="left:17%;top:36%;width:66%;height:35%"></button>
      </div>
    </section>

    <aside class="side-card">
      <div class="side-title">
        <h2>DDL-01</h2>
        <p>Resumo do equipamento</p>
      </div>
      <div class="quick">
        <div class="metric"><small>Fluido</small><b>Amônia</b></div>
        <div class="metric"><small>Volume</small><b>540 L</b></div>
        <div class="metric"><small>PMTA</small><b>16 kgf/cm²</b></div>
        <div class="metric"><small>Ano</small><b>2023</b></div>
      </div>
      <div class="legend">
        <div class="legend-item"><i class="dot" style="background:#1d4ed8"></i> Válvulas de serviço</div>
        <div class="legend-item"><i class="dot" style="background:#15803d"></i> Instrumentação</div>
        <div class="legend-item"><i class="dot" style="background:#c62828"></i> Dispositivo de segurança</div>
        <div class="legend-item"><i class="dot" style="background:#b7791f"></i> Dados gerais do vaso</div>
      </div>
      <p class="tip">Os dados detalhados permanecem ocultos até que um componente seja selecionado.</p>
    </aside>
  </main>

  <div class="footer">Visualização técnica interativa — DDL-01</div>
</div>

<div class="drawer-backdrop" id="backdrop"></div>
<aside class="drawer" id="drawer" aria-hidden="true">
  <div class="drawer-head">
    <div>
      <h3 id="drawerTitle">Componente</h3>
      <p id="drawerSubtitle">Informações técnicas</p>
    </div>
    <button class="close" id="closeDrawer" aria-label="Fechar painel">×</button>
  </div>
  <div class="drawer-body" id="drawerBody"></div>
</aside>

<script>
const DATA = {
  equipamento: {
    title: "Dados gerais do vaso",
    subtitle: "Distribuidor de Líquido — DDL-01",
    badge: "Vaso de pressão — Categoria III",
    sections: [
      {
        title: "Identificação",
        rows: [
          ["Equipamento","Distribuidor de Líquido"],
          ["TAG","DDL-01"],
          ["Fabricante","MADEF"],
          ["Modelo","RDL-5"],
          ["Nº de série","230.161"],
          ["Ano de fabricação","2023"],
          ["Finalidade","Armazenamento de fluido refrigerante"],
          ["Código de projeto","ASME Seção VIII — 2021"]
        ]
      },
      {
        title: "Dimensões e operação",
        rows: [
          ["Fluido","Amônia"],
          ["Volume interno","0,54 m³ / 540 L"],
          ["Diâmetro externo","644,0 mm"],
          ["Diâmetro interno","625,0 mm"],
          ["Comprimento do corpo","1.500 mm"],
          ["PMTA","16,00 kgf/cm²"],
          ["Pressão de teste hidrostático","24,00 kgf/cm²"]
        ]
      },
      {
        title: "Espessuras",
        rows: [
          ["Espessura nominal do corpo","9,5 mm"],
          ["Espessura nominal dos tampos","9,5 mm"],
          ["Espessura mínima calculada","5,13 mm"],
          ["Menor medição registrada","9,95 mm"]
        ],
        note: "No relatório, as medições por ultrassom ficaram acima da espessura mínima calculada."
      }
    ]
  },
  manometro: {
    title: "Manômetro",
    subtitle: "Instrumentação de pressão",
    badge: "Instrumentação",
    sections: [
      {
        title: "Função e condição",
        rows: [
          ["Componente","Indicador de pressão"],
          ["Função","Monitorar a pressão do vaso durante a operação"],
          ["Condição registrada","Funcionando normalmente"],
          ["Observação","Manter o manômetro sempre visível"]
        ]
      }
    ]
  },
  psv: {
    title: "Válvula de segurança — PSV",
    subtitle: "Dispositivo de proteção contra sobrepressão",
    badge: "Dispositivo de segurança",
    sections: [
      {
        title: "Função e condição",
        rows: [
          ["Componente","Válvula de segurança / alívio"],
          ["Função","Proteção do vaso contra sobrepressão"],
          ["Condição registrada","Dispositivos de segurança calibrados"],
          ["Inspeção","Válvulas de segurança examinadas e calibradas"]
        ],
        note: "A pressão de ajuste individual da PSV não está indicada no trecho do relatório utilizado nesta interface."
      }
    ]
  },
  servico1: {
    title: "Válvula de serviço — entrada",
    subtitle: "Conexão lateral superior esquerda",
    badge: "Válvula de serviço",
    sections: [
      {
        title: "Identificação visual",
        rows: [
          ["Posição","Entrada / conexão lateral superior esquerda"],
          ["Tipo","Válvula de serviço"],
          ["Função geral","Isolamento e manobra da linha conectada ao vaso"]
        ],
        note: "A função de processo exata deve ser confirmada no P&ID/fluxograma da instalação."
      }
    ]
  },
  servico2: {
    title: "Válvula de serviço — superior",
    subtitle: "Conexão superior central",
    badge: "Válvula de serviço",
    sections: [
      {
        title: "Identificação visual",
        rows: [
          ["Posição","Conexão superior central"],
          ["Tipo","Válvula de serviço"],
          ["Função geral","Isolamento e manobra da linha conectada ao vaso"]
        ],
        note: "A função de processo exata deve ser confirmada no P&ID/fluxograma da instalação."
      }
    ]
  },
  servico3: {
    title: "Válvula de serviço — saída inferior",
    subtitle: "Conexão inferior esquerda",
    badge: "Válvula de serviço",
    sections: [
      {
        title: "Identificação visual",
        rows: [
          ["Posição","Saída inferior esquerda"],
          ["Tipo","Válvula de serviço"],
          ["Função geral","Isolamento e manobra da linha inferior"]
        ],
        note: "A função de processo exata deve ser confirmada no P&ID/fluxograma da instalação."
      }
    ]
  },
  servico4: {
    title: "Válvula de serviço — dreno",
    subtitle: "Conexão inferior direita",
    badge: "Válvula de serviço",
    sections: [
      {
        title: "Identificação visual",
        rows: [
          ["Posição","Conexão inferior direita"],
          ["Identificação visual","Dreno"],
          ["Tipo","Válvula de serviço"],
          ["Função geral","Isolamento/manobra da conexão inferior"]
        ],
        note: "A função de processo e a destinação da linha devem ser confirmadas no P&ID/fluxograma da instalação."
      }
    ]
  }
};

const drawer = document.getElementById("drawer");
const backdrop = document.getElementById("backdrop");
const closeBtn = document.getElementById("closeDrawer");
const titleEl = document.getElementById("drawerTitle");
const subtitleEl = document.getElementById("drawerSubtitle");
const bodyEl = document.getElementById("drawerBody");

function renderRows(rows) {
  return `<div class="table">${rows.map(r => `
    <div class="row">
      <div class="cell k">${r[0]}</div>
      <div class="cell">${r[1]}</div>
    </div>`).join("")}</div>`;
}

function openDrawer(key) {
  const item = DATA[key];
  if (!item) return;
  titleEl.textContent = item.title;
  subtitleEl.textContent = item.subtitle || "Informações técnicas";
  bodyEl.innerHTML = `
    ${item.badge ? `<div class="section"><span class="badge">${item.badge}</span></div>` : ""}
    ${item.sections.map(s => `
      <section class="section">
        <h4>${s.title}</h4>
        ${s.rows ? renderRows(s.rows) : ""}
        ${s.note ? `<div class="note" style="margin-top:10px">${s.note}</div>` : ""}
      </section>
    `).join("")}
  `;
  drawer.classList.add("show");
  backdrop.classList.add("show");
  drawer.setAttribute("aria-hidden","false");
  closeBtn.focus();
}

function closeDrawer() {
  drawer.classList.remove("show");
  backdrop.classList.remove("show");
  drawer.setAttribute("aria-hidden","true");
}

document.querySelectorAll(".zone").forEach(btn => {
  btn.addEventListener("click", () => openDrawer(btn.dataset.key));
});
closeBtn.addEventListener("click", closeDrawer);
backdrop.addEventListener("click", closeDrawer);
document.addEventListener("keydown", e => {
  if (e.key === "Escape") closeDrawer();
});
</script>
</body>
</html>
